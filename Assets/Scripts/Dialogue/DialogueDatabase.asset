  m_Script: {fileID: 11500000, guid: 5517b3eb9c7294548998e2ae8d1b67ad, type: 3}
  m_Name: DialogueDatabase
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDatabase
  nodes:
  - nodeId: day1_start
    speakerName: 1일 차
    dialogueText: 아침이다. 핸드폰이나 볼까
    choices:
    - optionId: reply
      buttonText: 진행하기
      mentalChange: 10
      nextStoryId: friend_conversation
      nextDialogueNodeId: 
  - nodeId: day2_start
    speakerName: 2일 차
    dialogueText: 방이 어제보다 더 조용하게 느껴진다. 커튼을 열어 볼까?
    choices:
    - optionId: open_curtains
      buttonText: 커튼 열기
      mentalChange: 5
      nextStoryId: day2_curtains_open
      nextDialogueNodeId: 
    - optionId: stay_in_dark
      buttonText: 어둠 속에 있기
      mentalChange: -15
      nextStoryId: day2_curtains_closed
      nextDialogueNodeId: 
  - nodeId: day1_phone
    speakerName: 휴대폰
    dialogueText: 부모님에게 연락이 와 있다.
    choices:
    - optionId: check_parent_message
      buttonText: 확인한다
      mentalChange: 0
      nextStoryId: day1_phone_checked
      nextDialogueNodeId: day1_parent_message
    - optionId: do_not_check_parent_message
      buttonText: 안한다
      mentalChange: -5
      nextStoryId: day1_phone_not_checked
      nextDialogueNodeId:
  - nodeId: day1_parent_message
    speakerName: 부모님
    dialogueText: 잘 지내니? 연락 좀 하고 살자
    choices:
    - optionId: reply_to_parent
      buttonText: 답장하기
      mentalChange: 0
      nextStoryId: day1_parent_replied
      nextDialogueNodeId: day1_parent_reply
    - optionId: ignore_parent_message
      buttonText: 무시하기
      mentalChange: 0
      nextStoryId: day1_parent_message_ignored
      nextDialogueNodeId:
  - nodeId: day1_parent_reply
    speakerName: 나
    dialogueText: 자고 있었어...
    choices:
    - optionId: close_parent_reply
      buttonText: 확인
      mentalChange: 0
      nextStoryId: day1_parent_reply_finished
      nextDialogueNodeId:
  - nodeId: day1_meal
    speakerName: 식사
    dialogueText: 밥..먹어야지..
    choices:
    - optionId: eat
      buttonText: 먹는다
      mentalChange: 0
      nextStoryId: day1_meal_eaten
      nextDialogueNodeId:
  - nodeId: day1_medicine
    speakerName: 약
    dialogueText: 내가 그정돈가..?
    choices:
    - optionId: put_away
      buttonText: 약을 치운다
      mentalChange: -20
      nextStoryId: day1_medicine_put_away
      nextDialogueNodeId:
  - nodeId: day1_tidy
    speakerName: 청소
    dialogueText: 쓰래기가 쌓여있네..치울까
    choices:
    - optionId: day1_tidy
      buttonText: 조금이라도 치우자
      mentalChange: 4
      nextStoryId: day1_tidy
      nextDialogueNodeId:
    - optionId: day1_tidy_skip
      buttonText: 귀찮아...
      mentalChange: -1
      nextStoryId: day1_tidy_skip
      nextDialogueNodeId:
  - nodeId: day1_shower
    speakerName: 세면대
    dialogueText: 세수라도 하자
