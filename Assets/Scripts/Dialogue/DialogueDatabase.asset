  - nodeId: day1_mirror
    speakerName: 거울
    dialogueText: 정신차리자..
    choices:
    - optionId: day1_mirror_confirm
      buttonText: 확인
      mentalChange: 0
      nextStoryId: day1_mirror_confirmed
      nextDialogueNodeId:
  - nodeId: day2_meal
